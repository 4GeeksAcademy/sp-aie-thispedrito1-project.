# Copy to .env.local for native (non-Docker) dev: `cp .env.local.example .env.local`.
# Not needed inside Docker — docker-compose.yml already passes this through
# from the root .env via env_file.
#
# Called directly from the user's browser (not through the /api-proxy
# rewrite http.ts uses for the rest of the API), so it stays a full URL —
# never hardcode this value in source, always read it from here.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

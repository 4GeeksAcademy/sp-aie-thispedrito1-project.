# Servidor MCP de HealthCore. Copia a mcps/healthcore/.env y rellena.

# --- OAuth (Logto Cloud) ---
# Emisor OIDC de tu tenant: Logto Console → Applications → cualquier app → "Issuer endpoint".
MCP_OAUTH_ISSUER=https://<tenant>.logto.app/oidc
# Identificador de la API resource creada en Logto (Console → API resources). Es el `aud` de los tokens.
MCP_AUDIENCE=http://localhost:8765/mcp
# URL pública del endpoint MCP que se anuncia en /.well-known/oauth-protected-resource/mcp.
# En local coincide con MCP_AUDIENCE; en Codespaces, la URL reenviada: https://<codespace>-8765.app.github.dev/mcp
MCP_RESOURCE_URL=http://localhost:8765/mcp
# Hosts extra aceptados por la protección DNS-rebinding (separados por comas). El de MCP_RESOURCE_URL ya se incluye.
MCP_ALLOWED_HOSTS=
# En Codespaces: MCP_HOST=0.0.0.0 para que el reenvío de puertos llegue al proceso.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# --- API de HealthCore (Incidents Manager + inventario) ---
HEALTHCORE_API_URL=http://localhost:8000
# Cuenta de servicio con rol `user` (nunca admin): el MCP llama a la API en su nombre.
# Créala con: services/api/.venv/bin/python scripts/create_mcp_service_account.py
HEALTHCORE_API_EMAIL=mcp-service@healthcore.com
HEALTHCORE_API_PASSWORD=

# --- Solo para pruebas manuales (curl / MCP Playground); el servidor no las lee ---
# App M2M de pruebas en Logto (rol con los tres permisos).
MCP_TESTER_CLIENT_ID=
MCP_TESTER_CLIENT_SECRET=

# Salidas de validacion del pipeline de negocio (data/pipelines/pipeline.py):
# agregados de negocio por corrida, se regeneran en cada ejecucion.
data/eval/monthly_clinic_supply_performance/

# Backups nocturnos de telemetry_events (scripts/nightly_export.py): llevan
# userId seudonimizados y datos operativos. Nunca al repo (HIPAA / UK GDPR).
data/raw/telemetry_*.csv
data/raw/.telemetry_*.csv.tmp

# Traces de las corridas del agente LangGraph (POST /agent/query). Llevan la
# respuesta generada; la pregunta va solo como huella. Los traces de los
# evals (data/eval/agent-traces/) sí se versionan.
data/traces/

# PDFs de RFP subidos por el backoffice (Hito 9) y su Markdown redactado:
# artefacto de runtime de la recepción, nunca se versiona (podrían traer PHI).
data/raw/rfp/

# Orquestador de incorporaciones: checkpointer SQLite local y cuentas de demo
data/onboarding/
# Proveedores y contratos: datos generados por scripts/seed_supplier_contracts.py
# (contratos con datos bancarios ficticios) y cuentas de demo.
data/raw/supplier-contracts/
data/supplier_contracts/

# Cierre financiero: CSV generados por scripts/seed_financial_close.py y cuentas de demo.
data/raw/financial-close/
data/financial_close/
# Roles y Permisos: cuentas de demo de scripts/seed_roles_permissions.py
# (copia de la TinyDB con hashes de contraseña).
data/roles_permissions/
# Autenticación federada: cuentas de demo de scripts/seed_federated_auth.py.
data/federated_auth/
# Registro de Auditoría: cuentas de demo de scripts/seed_audit_log.py.
data/audit_log/

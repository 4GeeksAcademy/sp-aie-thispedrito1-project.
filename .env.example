# Root .env for `docker compose up`. Copy to .env and fill in real values —
# .env is gitignored and must never be committed.
#
# These are the same variables services/api/.env already has (see
# services/api/.env.example for details on each) — docker-compose.yml's
# `env_file: .env` passes them straight into the api container's
# environment, same as python-dotenv does locally.

JWT_SECRET_KEY=change-this-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUPPLIERS_DB_PATH=./data/suppliers.db.json
RESET_TOKEN_EXPIRE_MINUTES=30

# Browser-facing: opened by a real person clicking the reset-password email
# link on the host machine, not container-to-container — stays localhost.
FRONTEND_BASE_URL=http://localhost:3000

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Docker-only: the uis container's Next.js rewrite proxy (uis/backoffice/next.config.ts)
# uses this to reach the api container by Docker service name, never localhost.
BACKEND_API_URL=http://api:8000

# Browser-facing, same reasoning as FRONTEND_BASE_URL above: the backoffice
# calls this directly from the user's own browser, not container-to-container,
# so it stays localhost even inside Docker.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Async task queue (Ticket #DEV-55). Not needed here: docker-compose.yml sets
# REDIS_URL=redis://redis:6379/0 (Docker service name) for api, worker and
# flower, and that `environment:` entry wins over this file.

# Base de conocimiento RAG (Hito 7): mismos valores que services/api/.env
# (ver services/api/.env.example). QDRANT_URL no hace falta aquí:
# docker-compose.yml fija http://qdrant:6333 para el contenedor api.
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
GENERATION_MODEL=madrid-spain/openai/gpt-5.6-luna

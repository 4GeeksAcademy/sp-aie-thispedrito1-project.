JWT_SECRET_KEY=change-this-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUPPLIERS_DB_PATH=./data/suppliers.db.json

# Password reset flow (AUTH-03)
# Lifetime of the signed password-reset token, in minutes (15-60 recommended).
RESET_TOKEN_EXPIRE_MINUTES=30
# Base URL of the frontend; used to build the reset link sent by email.
FRONTEND_BASE_URL=http://localhost:3000
# Transactional email (Resend). Get a key at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Verified sender. Resend's onboarding sender works without a custom domain in dev.
EMAIL_FROM=onboarding@resend.dev

# Inventory module (Hito 5): Supabase Postgres connection string.
# In Supabase: Connect -> Direct tab -> Transaction pooler -> URI. Replace [PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Telemetry: unused by the Phase 1 stub (telemetry_service.py logs directly,
# no self-call), read here only to establish the settings pattern Phase 3
# will need once this forwards to a real pipeline instead of just logging.
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Async task queue (Ticket #DEV-55): Redis as Celery broker AND result backend.
# The API (producer) and the worker (consumer) must point at the SAME Redis.
# Native dev: the redis service of docker-compose.yml, published on localhost.
# Optional: this is also the default when the variable is missing.
REDIS_URL=redis://localhost:6379/0

# Base de conocimiento RAG (Hito 7). Modelos proporcionados por 4Geeks a través
# de un endpoint compatible con OpenAI: URL base + clave de estudiante.
# EMBEDDING_MODEL y GENERATION_MODEL deben ser IDs DISTINTOS: el primero
# convierte texto en vectores (embed), el segundo redacta la respuesta (query).
LLM_BASE_URL=https://llm.4geeks.ai
LLM_API_KEY=
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
GENERATION_MODEL=madrid-spain/openai/gpt-5.6-luna
# Qdrant del docker-compose.yml (servicio `qdrant`), publicado solo en localhost.
# Opcional: este es también el valor por defecto si falta la variable.
QDRANT_URL=http://localhost:6333
# Opcional: similitud coseno mínima para que un fragmento cuente como contexto.
# El valor por defecto está afinado con data/eval/test-queries.json (docs/rag/rag-design.md).
# RAG_MIN_SCORE=

# Agente como cliente del servidor MCP de HealthCore (mcps/healthcore).
# Aplicación Machine-to-Machine del agente en Logto, con SOLO el permiso incidents:read.
MCP_SERVER_URL=http://localhost:8765/mcp
MCP_OAUTH_TOKEN_ENDPOINT=https://<tenant>.logto.app/oidc/token
MCP_AUDIENCE=http://localhost:8765/mcp
MCP_AGENT_CLIENT_ID=
MCP_AGENT_CLIENT_SECRET=
MCP_AGENT_SCOPES=incidents:read
